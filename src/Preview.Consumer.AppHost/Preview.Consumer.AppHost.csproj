<Project Sdk="Aspire.AppHost.Sdk/13.4.6">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PreviewContractVersion Condition="'$(PreviewContractVersion)' == ''">0.0.0-local</PreviewContractVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shirubasoft.Aspire.ModularAppHosts" Version="[1.1.0]" />
    <PackageReference Include="Shirubasoft.Aspire.ModularAppHosts.PreviewProducer.Contract"
                      Version="[$(PreviewContractVersion)]" />
  </ItemGroup>
</Project>

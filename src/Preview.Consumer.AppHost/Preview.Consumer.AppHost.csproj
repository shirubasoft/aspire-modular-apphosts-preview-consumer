<Project Sdk="Aspire.AppHost.Sdk/13.4.6">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ModularAppHostsVersion Condition="'$(ModularAppHostsVersion)' == ''">0.0.0-local</ModularAppHostsVersion>
    <PreviewContractVersion Condition="'$(PreviewContractVersion)' == ''">2.0.0-preview.6.1</PreviewContractVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shirubasoft.Aspire.ModularAppHosts"
                      Version="[$(ModularAppHostsVersion)]" />
    <PackageReference Include="Shirubasoft.Aspire.ModularAppHosts.PreviewProducer.Contract"
                      Version="[$(PreviewContractVersion)]" />
  </ItemGroup>
</Project>
